# Database (PostgreSQL - gebruik Neon.tech of Vercel Postgres)
# Voor Neon: maak gratis account op neon.tech → copy connection string
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Neon heeft twee URL's: pool URL (boven) en direct URL (hieronder)
# Als je andere Postgres gebruikt, vul hetzelfde in voor beide
DIRECT_URL="postgresql://user:password@host/database?sslmode=require"

# NextAuth (genereer met: openssl rand -base64 32)
NEXTAUTH_SECRET="vervang-dit-met-een-lang-willekeurig-secret"
NEXTAUTH_URL="https://jouw-app.vercel.app"

# TheSportsDB API (optioneel)
SPORTSDB_API_KEY=""
